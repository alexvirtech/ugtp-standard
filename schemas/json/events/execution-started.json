{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ugtp.dev/schemas/v0.1/events/execution-started.json",
  "title": "execution.started",
  "description": "Emitted when execution begins. Status: CANDIDATE.",
  "type": "object",
  "required": ["eventType", "timestamp", "payload"],
  "additionalProperties": false,
  "properties": {
    "eventType": {
      "const": "execution.started"
    },
    "timestamp": {
      "$ref": "../types.json#/$defs/Timestamp"
    },
    "correlationId": {
      "$ref": "../types.json#/$defs/CorrelationId"
    },
    "payload": {
      "type": "object",
      "required": ["executionId", "intentId"],
      "additionalProperties": false,
      "properties": {
        "executionId": {
          "$ref": "../types.json#/$defs/ExecutionId"
        },
        "intentId": {
          "$ref": "../types.json#/$defs/IntentId"
        }
      }
    }
  }
}
