{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ugtp.dev/schemas/v0.1/events/execution-step-updated.json",
  "title": "execution.step.updated",
  "description": "Emitted when an execution step changes status. Status: CANDIDATE.",
  "type": "object",
  "required": ["eventType", "timestamp", "payload"],
  "additionalProperties": false,
  "properties": {
    "eventType": {
      "const": "execution.step.updated"
    },
    "timestamp": {
      "$ref": "../types.json#/$defs/Timestamp"
    },
    "correlationId": {
      "$ref": "../types.json#/$defs/CorrelationId"
    },
    "payload": {
      "type": "object",
      "required": ["executionId", "stepId", "status"],
      "additionalProperties": false,
      "properties": {
        "executionId": {
          "$ref": "../types.json#/$defs/ExecutionId"
        },
        "stepId": {
          "$ref": "../types.json#/$defs/StepId"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "submitted", "confirmed", "failed", "skipped"]
        },
        "transactionHash": {
          "$ref": "../types.json#/$defs/Hash"
        }
      }
    }
  }
}
