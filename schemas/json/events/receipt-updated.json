{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ugtp.dev/schemas/v0.1/events/receipt-updated.json",
  "title": "receipt.updated",
  "description": "Emitted when a receipt is updated. Status: CANDIDATE.",
  "type": "object",
  "required": ["eventType", "timestamp", "payload"],
  "additionalProperties": false,
  "properties": {
    "eventType": {
      "const": "receipt.updated"
    },
    "timestamp": {
      "$ref": "../types.json#/$defs/Timestamp"
    },
    "correlationId": {
      "$ref": "../types.json#/$defs/CorrelationId"
    },
    "payload": {
      "type": "object",
      "required": ["receiptId", "status"],
      "additionalProperties": false,
      "properties": {
        "receiptId": {
          "$ref": "../types.json#/$defs/ReceiptId"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "confirmed", "failed", "partial"]
        }
      }
    }
  }
}
