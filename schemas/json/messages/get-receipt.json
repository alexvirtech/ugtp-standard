{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ugtp.dev/schemas/v0.1/messages/get-receipt.json",
  "title": "GetReceipt Messages",
  "description": "Request/Response for receipt retrieval. Status: CANDIDATE.",
  "$defs": {
    "GetReceiptRequest": {
      "type": "object",
      "required": ["receiptId"],
      "additionalProperties": false,
      "properties": {
        "receiptId": {
          "$ref": "../types.json#/$defs/ReceiptId"
        },
        "correlationId": {
          "$ref": "../types.json#/$defs/CorrelationId"
        }
      }
    },
    "GetReceiptResponse": {
      "type": "object",
      "required": ["receipt"],
      "additionalProperties": false,
      "properties": {
        "receipt": {
          "$ref": "../objects/unified-receipt.json"
        },
        "correlationId": {
          "$ref": "../types.json#/$defs/CorrelationId"
        }
      }
    }
  }
}
