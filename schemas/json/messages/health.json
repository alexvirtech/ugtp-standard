{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ugtp.dev/schemas/v0.1/messages/health.json",
  "title": "Health Messages",
  "description": "Request/Response for health check. Stability: FROZEN.",
  "x-ugtp-architecture": {
    "source": "UGTP-ARCH-001",
    "classification": "FROZEN",
    "stabilityLevel": "FROZEN",
    "breakingChangeRisk": "none",
    "relatedADR": ["ADR-0019"],
    "relatedCapability": [],
    "relatedProfile": ["ugtp:profile:core"],
    "relatedFeature": []
  },
  "$defs": {
    "HealthRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "correlationId": {
          "$ref": "../types.json#/$defs/CorrelationId"
        }
      }
    },
    "HealthResponse": {
      "type": "object",
      "required": ["status", "version", "timestamp"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": ["healthy", "degraded", "unhealthy"]
        },
        "version": {
          "$ref": "../types.json#/$defs/ProtocolVersion"
        },
        "timestamp": {
          "$ref": "../types.json#/$defs/Timestamp"
        },
        "adapters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["chainId", "status"],
            "properties": {
              "chainId": {
                "$ref": "../types.json#/$defs/ChainId"
              },
              "status": {
                "type": "string",
                "enum": ["healthy", "degraded", "unhealthy"]
              }
            }
          }
        },
        "correlationId": {
          "$ref": "../types.json#/$defs/CorrelationId"
        }
      }
    }
  }
}
