{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ugtp.dev/schemas/v0.1/messages/resolve-uci.json",
  "title": "ResolveUCI Messages",
  "description": "Request/Response for UCI resolution. Status: CANDIDATE.",
  "$defs": {
    "ResolveUCIRequest": {
      "type": "object",
      "required": ["uciId"],
      "additionalProperties": false,
      "properties": {
        "uciId": {
          "$ref": "../types.json#/$defs/UciId"
        },
        "correlationId": {
          "$ref": "../types.json#/$defs/CorrelationId"
        }
      }
    },
    "ResolveUCIResponse": {
      "type": "object",
      "required": ["uci"],
      "additionalProperties": false,
      "properties": {
        "uci": {
          "$ref": "../objects/uci.json"
        },
        "correlationId": {
          "$ref": "../types.json#/$defs/CorrelationId"
        }
      }
    }
  }
}
