{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ugtp.dev/schemas/v0.1/objects/protocol-error.json",
  "title": "ProtocolError",
  "description": "Structured error response. Stability: FROZEN.",
  "x-ugtp-architecture": {
    "source": "UGTP-ARCH-001",
    "classification": "FROZEN",
    "stabilityLevel": "FROZEN",
    "breakingChangeRisk": "none",
    "relatedADR": [],
    "relatedCapability": [],
    "relatedProfile": ["ugtp:profile:core"],
    "relatedFeature": []
  },
  "type": "object",
  "required": ["code", "message"],
  "additionalProperties": false,
  "properties": {
    "code": {
      "$ref": "../types.json#/$defs/ErrorCode"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "details": {
      "type": "object",
      "additionalProperties": true
    },
    "correlationId": {
      "$ref": "../types.json#/$defs/CorrelationId"
    },
    "retryable": {
      "type": "boolean"
    },
    "retryAfter": {
      "type": "integer",
      "minimum": 0,
      "description": "Seconds to wait before retrying"
    }
  }
}
