{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ugtp.dev/schemas/v0.1/objects/uci.json",
  "title": "UCI",
  "description": "Universal Crypto Identity — persistent identity anchor. Stability: FROZEN.",
  "x-ugtp-architecture": {
    "source": "UGTP-ARCH-001",
    "classification": "FROZEN",
    "stabilityLevel": "FROZEN",
    "breakingChangeRisk": "none",
    "relatedADR": ["ADR-0001", "ADR-0002"],
    "relatedCapability": ["ugtp:capability:identity:create", "ugtp:capability:identity:manage"],
    "relatedProfile": ["ugtp:profile:core"],
    "relatedFeature": ["FEAT-RECOVERY"]
  },
  "type": "object",
  "required": ["uciId", "createdAt", "status"],
  "additionalProperties": false,
  "properties": {
    "uciId": {
      "$ref": "../types.json#/$defs/UciId"
    },
    "createdAt": {
      "$ref": "../types.json#/$defs/Timestamp"
    },
    "updatedAt": {
      "$ref": "../types.json#/$defs/Timestamp"
    },
    "status": {
      "type": "string",
      "enum": ["active", "suspended", "recovering"]
    },
    "recoveryHash": {
      "$ref": "../types.json#/$defs/Hash"
    }
  }
}
